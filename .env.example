NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://acs:acs@localhost:5432/acs
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-me-with-at-least-32-characters-long
OTP_SECRET=a-different-secret-at-least-32-characters
BUSINESS_TIMEZONE=Asia/Jerusalem
SUPPORTED_LOCALES=en,he
DEFAULT_LOCALE=he

# SMS_PROVIDER=fake captures codes in memory instead of sending them, so local
# development needs no gateway account. Switch to sms4free and fill all four.
SMS_PROVIDER=fake
SMS4FREE_API_KEY=
SMS4FREE_USER=
SMS4FREE_PASS=
SMS4FREE_SENDER=
SMS_SUPPORTED_COUNTRIES=IL

# PUSH_PROVIDER=fake records notifications in memory instead of sending them,
# so local development needs no Expo project. EXPO_ACCESS_TOKEN is only needed
# if the Expo project has enhanced push security enabled.
PUSH_PROVIDER=fake
EXPO_ACCESS_TOKEN=

# BullMQ. QUEUE_PREFIX namespaces Redis keys so environments sharing a Redis
# do not consume each other's jobs.
QUEUE_PREFIX=acs
SCHEDULER_TICK_SEC=15
WORKER_CONCURRENCY=5
