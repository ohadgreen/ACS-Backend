{
  "name": "acs-backend",
  "version": "0.1.0",
  "description": "ACS Backend — drone-operator on-demand video booking API",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:dev": "node -r @swc-node/register src/main.ts",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "node -r @swc-node/register src/cli/migrate.ts",
    "seed:admin": "node -r @swc-node/register src/cli/seed-admin.ts",
    "lint": "eslint .",
    "migrate:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.0",
    "drizzle-orm": "^0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.12",
    "luxon": "^3.7.2",
    "ms": "^2.1.3",
    "nestjs-pino": "^5.1.0",
    "nestjs-zod": "^5.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/testing": "^11.2.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.5",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "unplugin-swc": "^1.5.11",
    "vitest": "^5.0.0"
  }
}
